{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": ".", 
    "binding": "ASSETS",
    // .git klasörünün yüklenmesini engellemek için ignore eklenmelidir:
    "ignore": [
      ".git",
      ".wrangler",
      "node_modules"
    ]
  }
}
